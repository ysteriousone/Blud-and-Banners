      "StartingHistoryEffects": "set_technology = {\r\n    infantry_weapons = 1\r\n    infantry_weapons1 = 1\r\n    tech_recon = 1\r\n    tech_support = 1\r\n    tech_engineers = 1\r\n    tech_mountaineers = 1\r\n    tech_trucks = 1\r\n    motorised_infantry = 1\r\n    gw_artillery = 1\r\n    interwar_antiair = 1\r\n    fuel_silos = 1\r\n    synth_oil_experiments = 1\r\n    oil_processing = 1\r\n    fuel_refining = 1\r\n}\r\nset_grand_doctrine = new_mobile_warfare\r\nset_grand_doctrine = new_convoy_raiding\r\nset_grand_doctrine = new_battlefield_support\r\nIF = {\r\n    limit = {\r\n        NOT = {\r\n            has_dlc = \u0022By Blood Alone\u0022\r\n        }\r\n    }\r\n    set_technology = {\r\n        early_fighter = 1\r\n        fighter1 = 1\r\n        early_bomber = 1\r\n        tactical_bomber1 = 1\r\n        strategic_bomber1 = 1\r\n        CAS1 = 1\r\n        naval_bomber1 = 1\r\n    }\r\n}\r\nIF = {\r\n    limit = {\r\n        NOT = {\r\n            has_dlc = \u0022No Step Back\u0022\r\n        }\r\n    }\r\n    set_technology = {\r\n        gwtank = 1\r\n        basic_light_tank = 1\r\n        improved_light_tank = 1\r\n        basic_heavy_tank = 1\r\n    }\r\n}\r\nIF = {\r\n    limit = {\r\n        has_dlc = \u0022No Step Back\u0022\r\n    }\r\n    set_technology = {\r\n        gwtank_chassis = 1\r\n        basic_light_tank_chassis = 1\r\n        improved_light_tank_chassis = 1\r\n        basic_heavy_tank_chassis = 1\r\n    }\r\n}\r\nIF = {\r\n    limit = {\r\n        not = {\r\n            has_dlc = \u0022Man the Guns\u0022\r\n        }\r\n    }\r\n    set_technology = {\r\n        transport = 1\r\n    }\r\n}\r\nIF = {\r\n    limit = {\r\n        has_dlc = \u0022Man the Guns\u0022\r\n    }\r\n    set_technology = {\r\n        mtg_transport = 1\r\n    }\r\n}\r\nrecruit_character = UBD_heinrich_schlobitten\r\nadd_ideas = {\r\n}",
